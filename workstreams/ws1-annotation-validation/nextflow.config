// WS1 annotation & validation workflow skeleton.
// The colored task modules (T1 conversion, T2 core, T3 exploration) plug into
// this skeleton through the stage CLIs in bin/ and the single conda env in envs/ws1.yml.

manifest {
    name            = 'ws1-annotation-validation'
    description      = 'WS1: reproducible nucleic-acid annotation & validation workflow skeleton'
    author          = 'Simon Crouzet'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    input      = null              // structure: .pdb or .cif  (required)
    converter  = 'maxit'           // T1 converter: maxit (default, conda) | maxit-docker (tzok/maxit image) | gemmi (deprecated)
    annotators = 'fr3d,rnapolis'   // comma-separated annotator names (those wired in bin/ws1-annotate)
    visualize  = false             // T3: also emit per-tool base-pair graphs (forgi BulgeGraph + jpg)
    outdir     = 'results'
}

// Every run uses conda: all processes share the single env envs/ws1.yml (incl. maxit via bioconda::maxit).
// Docker is also enabled so the maxit-docker converter fallback (tzok/maxit image) works
// when selected; with the default maxit converter no container is used.
conda.enabled  = true
docker.enabled = true

// Execution reports of each run, next to its results.
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";      overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";    overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html";  overwrite = true }

// `-profile test`: identical run, on the bundled 9CFN input.
profiles {
    test {
        params.input      = "${projectDir}/../../data/9CFN/9CFN_clean.cif"
        params.annotators = 'fr3d,rnapolis'
    }
}
