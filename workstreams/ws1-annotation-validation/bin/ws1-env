#!/usr/bin/env bash
# Build the pipeline conda env once and print its prefix.
#
#     bin/ws1-env [env file]                  # default: envs/ws1.yml
#     nextflow run main.nf --env_file "$(bin/ws1-env)"
#
# The env lives in the conda cache ($NXF_CONDA_CACHEDIR, default ~/.cache/ws1-conda) as
# ws1-<first 12 hex digits of the sha256 of the env file>. Builds are serialised with flock, so
# concurrent calls build it once, and a build that was interrupted (no .ws1-complete marker) is
# removed and redone. Nextflow uses an existing env directory as it is, so runs that receive the
# prefix as --env_file never create an env themselves.
set -euo pipefail

project="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_file=${1:-$project/envs/ws1.yml}
cache=${NXF_CONDA_CACHEDIR:-$HOME/.cache/ws1-conda}
prefix="$cache/ws1-$(sha256sum "$env_file" | cut -c1-12)"
mkdir -p "$cache"

if [ ! -f "$prefix/.ws1-complete" ]; then
    if command -v flock > /dev/null; then
        exec 9> "$cache/.ws1-env.lock"
        flock 9
    else
        echo "ws1-env: flock not found, concurrent builds are not serialised" >&2
    fi
    if [ ! -f "$prefix/.ws1-complete" ]; then       # another call may have built it while this one waited
        rm -rf "$prefix"
        conda env create -q -p "$prefix" -f "$env_file" >&2
        touch "$prefix/.ws1-complete"
    fi
fi
echo "$prefix"
