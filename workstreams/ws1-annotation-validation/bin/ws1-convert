#!/usr/bin/env bash
# WS1 Converter (T1) — standardize an input structure to mmCIF.
#
# Contract (the Nextflow CONVERT process depends on it):
#     ws1-convert --input <structure.pdb|.cif> --out <structure.cif> [--converter maxit|maxit-docker|gemmi]
#
# Converters (--converter):
#   maxit (default)  RCSB MAXIT from conda (bioconda::maxit, envs/ws1.yml). Output mode:
#                    -o 1 for PDB input, -o 8 to refresh an existing mmCIF; -o 1 on a .cif
#                    gives malformed output (#76), so .cif/.mmcif inputs use -o 8.
#   maxit-docker     the same maxit, run from the tzok/maxit image (the module starts the
#                    container); for platforms without bioconda::maxit.
#   gemmi            DEPRECATED conda fallback.
set -euo pipefail

converter=maxit
input=
out=
while [ $# -gt 0 ]; do
    case "$1" in
        --input)     input=$2;     shift 2 ;;
        --out)       out=$2;       shift 2 ;;
        --converter) converter=$2; shift 2 ;;
        *) echo "ws1-convert: unknown argument '$1'" >&2; exit 2 ;;
    esac
done
[ -n "$input" ] && [ -n "$out" ] || { echo "usage: ws1-convert --input <pdb|cif> --out <cif> [--converter maxit|maxit-docker|gemmi]" >&2; exit 2; }

ext=${input##*.}
ext=${ext,,}
case "$converter" in
    maxit|maxit-docker)
        case "$ext" in
            pdb) maxit -input "$input" -output "$out" -o 1 ;;   # PDB -> mmCIF
            *)   maxit -input "$input" -output "$out" -o 8 ;;   # (m)mCIF -> refreshed mmCIF (#76)
        esac ;;
    gemmi)
        echo "[ws1-convert] WARNING: the 'gemmi' converter is DEPRECATED; maxit is the supported path." >&2
        gemmi convert "$input" "$out" ;;
    *)
        echo "ws1-convert: unknown converter '$converter' (expected maxit|maxit-docker|gemmi)" >&2; exit 2 ;;
esac
echo "[ws1-convert:$converter] $input -> $out" >&2
