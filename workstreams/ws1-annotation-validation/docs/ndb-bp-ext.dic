;
;
        loop_
        _ndb_base_pair_list_curated.id
        _ndb_base_pair_list_curated.PDB_accession_code
        _ndb_base_pair_list_curated.PDB_model_num
        _ndb_base_pair_list_curated.label_entity_id_1
