save_ndb_base_pair_provenance
    _category.description
;              Data items in the NDB_BASE_PAIR_PROVENACE category provides
               the provenance information for base pair identification. 
;
    _category.id                  ndb_base_pair_provenance
    _category.mandatory_code      no
     loop_
    _category_key.name          '_ndb_base_pair_provenance.entry_id'

    loop_
    _category_group.id           'inclusive_group'
                                 'ndb_group'
    loop_
    _category_examples.detail
    _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1 - 
;
;
        loop_
        _ndb_base_pair_provenance.entry_id
        _ndb_base_pair_provenance.software_id
        _ndb_base_pair_provenance.software_name
        _ndb_base_pair_provenance.software_version
        _ndb_base_pair_provenance.software_url
        _ndb_base_pair_provenance.bp_params_version
        _ndb_base_pair_provenance.details
        7Z7W 4 standa_bp  1.0	https://github.com/ 1.0 ?
         # ...  abbreviated ...
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
   _pdbx_category_context.type         CONTRIBUTED
   _pdbx_category_context.category_id  ndb_base_pair_provenance
     save_

