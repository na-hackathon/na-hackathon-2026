# -------------------------------------------------------------------------------------------------------------------------
#
#  File: ndb-bp-ext.dic
#  Date: 19-AUG-2026
#
#  Dictionary extension for nucleic acids base pair definitions
#
# -------------------------------------------------------------------------------------------------------------------------
#
data_ndb-bp-ext.dic

    _datablock.id                          ndb-bp-ext.dic
    _datablock.description
;
     This data block holds the extension dictionary defining
     nucleic acids base pairs for NDB. 
;

    _dictionary.title           ndb-bp-ext.dic
    _dictionary.datablock_id    ndb-bp-ext.dic
    _dictionary.version         0.07
#
     loop_
    _dictionary_history.version
    _dictionary_history.update
    _dictionary_history.revision
  0.07   2026-10-08
;
  Changes (js)
  + Rename ndb_base_pair_overall.average_NAPASCO to NAPASCO_global
    (pooled over all base pairs in all models)
  + Add ndb_base_pair_overall_model with per-model NAPASCO_global_model and
    base pair/unpaired counts
;
  0.06   2026-08-19
;
  Changes (js/bs/lb)
  + Add ndb_base_pair_annotation_curated, giving the Leontis-Westhof
    orientation/edge/family/class/sub_class for each curated base pair,
    derived from the data/curated/ sub_class directory names
  + Populate ndb_base_pair_annotation_curated in ndb-bp-ext-curated.cif
    alongside ndb_base_pair_list_curated (4639 rows)
;
  0.05   2026-08-19
;
  Changes (js/bs/lb)
  + Populate ndb_base_pair_list_curated in the external reference file
    ndb-bp-ext-curated.cif
  + Note in ndb_base_pair_list_curated.description that this category is
    populated externally and is the target of
    _ndb_base_pair_validation.nearest_curated_BP
;
  0.04   2026-08-19
;
  Changes (bv/bs/jc/lb)
  + Add ndb_base_pair_overall
  + Rename base_pair_annotation.family_num/family_name to l-w_family_num/l-w_family_name
    to match generated mmCIF output, and drop the leading '#' from family number values
  + Add ndb_base_pair_validation.details
  + Rename ndb_base_pair_validation.nearest_curated_bp to nearest_curated_BP to match
    generated mmCIF output
  + Update ndb_base_pair_validation.napasco_annotation enumeration to
    preferred/of_concern/not_applicable to match mmcif_parser.py output
  + Fix label_entity_id_1/_2 (base_pair_list, base_pair_list_curated) and
    label_entity_id (base_unpaired_list) item names that were missing the
    'label_' prefix
  + Add missing sub_class enumeration values observed in generated output
    (cWW_A-C_2, cWW_C-U_2, cWH_A-G_2, cWS_A-G_2, cWS_G-G_2, cHS_A-G_2,
    cHS_C-C_2, tHH_A-C_2, tWS_A-C_2, tWS_A-U_2)
;
  0.03   2026-01-08
;
  Changes (bv/bs/jc/lb)
  + Add ndb_base_pair_list_curated
  + Update ndb_base_pair_validation
; 
  0.02   2025-09-11
;
  Changes (bv/bs/jc/lb)
  + Add ndb_base_unpaired_list
;
  0.01   2025-02-05
;
  Changes (bv/bs/jc/lb)
  + Release as initial version 0.01
;
#########################
## CATEGORY_GROUP_LIST ##
#########################

     loop_
    _category_group_list.id
    _category_group_list.parent_id
    _category_group_list.description
##
              'inclusive_group'   .
;              The parent category group containing all of the data categories in the macromolecular dictionary.
;
              'ndb_group'
              'inclusive_group'
;              Categories that describe nucleic acids for NDB.
;
####################
## ITEM_TYPE_LIST ##
####################
#
#
#  The regular expressions defined here are not compliant
#  with the POSIX 1003.2 standard as they include the
#  '\n' and '\t' special characters.  These regular expressions
#  have been tested using version 0.12 of Richard Stallman's
#  GNU regular expression library in POSIX mode.
#
#
##############################################################################

     loop_
    _item_type_list.code
    _item_type_list.primitive_code
    _item_type_list.construct
    _item_type_list.detail
               code      char
               '[][_,.;:"&<>()/\{}'`~!@#$%A-Za-z0-9*|+-]*'
;              code item types/single words ...
;
               ucode      uchar
               '[][_,.;:"&<>()/\{}'`~!@#$%A-Za-z0-9*|+-]*'
;              code item types/single words  (case insensitive) ...
;
               line      char
               '[][ \t_(),.;:"&<>/\{}'`~!@#$%?+=*A-Za-z0-9|^-]*'
;              char item types / multi-word items ...
;
               uline      uchar
               '[][ \t_(),.;:"&<>/\{}'`~!@#$%?+=*A-Za-z0-9|^-]*'
;              char item types / multi-word items (case insensitive)...
;
               text      char
               '[][ \n\t()_,.;:"&<>/\{}'`~!@#$%?+=*A-Za-z0-9|^-]*'
;              text item types / multi-line text ...
;
               int       numb
               '[+-]?[0-9]+'
;              int item types are the subset of numbers that are the negative
               or positive integers.
;
               float     numb
          '-?(([0-9]+)[.]?|([0-9]*[.][0-9]+))([(][0-9]+[)])?([eE][+-]?[0-9]+)?'
;              float item types are the subset of numbers that are the floating
               numbers.
;
               name      uchar
               '_[_A-Za-z0-9]+\.[][_A-Za-z0-9%-]+'
;              name item types take the form...
;

