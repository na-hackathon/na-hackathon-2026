#########################################
## NDB_BASE_PAIR_ANNOTATION_CURATED ##
#########################################

save_ndb_base_pair_annotation_curated
    _category.description
;              Data items in the NDB_BASE_PAIR_ANNOTATION_CURATED category
               provide the Leontis-Westhof orientation, edge, family, class
               and sub-class annotation for each base pair in the curated
               dataset (provide reference). This category is populated, along
               with ndb_base_pair_list_curated, in the external reference file
               ndb-bp-ext-curated.cif, generated from the directory structure
               of data/curated/ (each sub-directory name is the sub_class of
               the curated base pairs it contains).
;
    _category.id                  ndb_base_pair_annotation_curated
    _category.mandatory_code      no
     loop_
    _category_key.name          '_ndb_base_pair_annotation_curated.id'

    loop_
    _category_group.id           'inclusive_group'
                                 'ndb_group'
    loop_
    _category_examples.detail
    _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1 -
;
;
        loop_
        _ndb_base_pair_annotation_curated.id
        _ndb_base_pair_annotation_curated.base_pair_id
        _ndb_base_pair_annotation_curated.orientation
        _ndb_base_pair_annotation_curated.base_1_edge
        _ndb_base_pair_annotation_curated.base_2_edge
        _ndb_base_pair_annotation_curated.l-w_family_num
        _ndb_base_pair_annotation_curated.l-w_family_name
        _ndb_base_pair_annotation_curated.class
        _ndb_base_pair_annotation_curated.sub_class
         1 1abc_A_G_2544_B_C_1558 cis Watson-Crick Watson-Crick 1 cWW cWW_G-C cWW_G-C_1
         # ...  abbreviated ...
;
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
   _pdbx_category_context.type         CONTRIBUTED
   _pdbx_category_context.category_id  ndb_base_pair_annotation_curated
     save_

save__ndb_base_pair_annotation_curated.id
    _item_description.description
;     Identifier for the category.
;
    _item.name                  '_ndb_base_pair_annotation_curated.id'
    _item.category_id             ndb_base_pair_annotation_curated
    _item.mandatory_code          yes
    _item_type.code               int
     save_

save__ndb_base_pair_annotation_curated.base_pair_id
    _item_description.description
;     Identifier for the curated base pair.
      This data item is a pointer to _ndb_base_pair_list_curated.id.
;
    _item.name                  '_ndb_base_pair_annotation_curated.base_pair_id'
    _item.category_id             ndb_base_pair_annotation_curated
    _item.mandatory_code          yes
    _item_type.code               code
    _item_linked.child_name       '_ndb_base_pair_annotation_curated.base_pair_id'
    _item_linked.parent_name      '_ndb_base_pair_list_curated.id'
     save_

save__ndb_base_pair_annotation_curated.orientation
    _item_description.description
;     Orientation of bases in the base pair.
;
    _item.name                  '_ndb_base_pair_annotation_curated.orientation'
    _item.category_id             ndb_base_pair_annotation_curated
    _item.mandatory_code          yes
    _item_type.code               code
    loop_
     _item_enumeration.value
     _item_enumeration.detail
     'cis'    'cis orientation'
     'trans'  'trans orientation'
     save_

save__ndb_base_pair_annotation_curated.base_1_edge
    _item_description.description
;     Edge of base 1 involved in base pairing.
