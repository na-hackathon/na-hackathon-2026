save_ndb_base_pair_list_curated
    _category.description
;              Data items in the NDB_BASE_PAIR_LIST_CURATED category identifies
               the nucleotide base pairs identified in the curated dataset as
               described in (provide reference). This category is populated in
               an external reference file, ndb-bp-ext-curated.cif, generated
               from the curated base pair coordinate fragments in data/curated/.
               It is not part of the mmCIF output produced by mmcif_parser.py;
               it is instead the target of _ndb_base_pair_validation.nearest_curated_BP.
;
    _category.id                  ndb_base_pair_list_curated
    _category.mandatory_code      no
     loop_
    _category_key.name          '_ndb_base_pair_list_curated.id'

    loop_
    _category_group.id           'inclusive_group'
                                 'ndb_group'
    loop_
