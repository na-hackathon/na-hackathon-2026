## NDB_BASE_PAIR_ANNOTATION ##
##############################

save_ndb_base_pair_annotation
    _category.description
;              Data items in the NDB_BASE_PAIR_STEP_ANNOTATION category provides
               annotations about base pairs.

;
    _category.id                  ndb_base_pair_annotation
    _category.mandatory_code      no
     loop_
    _category_key.name          '_ndb_base_pair_annotation.id'

    loop_
    _category_group.id           'inclusive_group'
                                 'ndb_group'
    loop_
    _category_examples.detail
    _category_examples.case
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
;
    Example 1 -
;
;
        loop_
        _ndb_base_pair_annotation.id
        _ndb_base_pair_annotation.base_pair_id
        _ndb_base_pair_annotation.orientation
        _ndb_base_pair_annotation.base_1_edge
        _ndb_base_pair_annotation.base_2_edge
        _ndb_base_pair_annotation.l-w_family_num
        _ndb_base_pair_annotation.l-w_family_name
        _ndb_base_pair_annotation.class
        _ndb_base_pair_annotation.sub_class
        _ndb_base_pair_annotation.details
         15 15 trans        Sugar        Sugar 12 tSS tSS_A-G tSS_A-G_1 ?
         16 16   cis Watson-Crick Watson-Crick  1 cWW cWW_G-C cWW_G-C_1 ?
