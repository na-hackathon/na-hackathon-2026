// nf-test runtime config. Processes run in params.env_file (envs/ws1.yml), as in `nextflow run`,
// from the conda cache set in nextflow.config (NXF_CONDA_CACHEDIR or ~/.cache/ws1-conda), so the
// env is built once for all tests.
conda.enabled  = true
docker.enabled = false
singularity.enabled = false
