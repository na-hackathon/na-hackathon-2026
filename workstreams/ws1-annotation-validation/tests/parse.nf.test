// nf-test for the PARSE module: runs the FR3D and RNApolis branches on every sample input
// under data/tests/ and checks that the base-pair mmCIF and the skipped-pairs file are emitted
// and that the mmCIF has the expected NDB categories. The row-by-row comparison with the
// reference files is in tests/test_parse_conversion.py (pytest).
// Run with: nf-test test tests/parse.nf.test
nextflow_process {

    name "Test Process PARSE"
    script "../modules/parse.nf"
    process "PARSE"

    def PDB_IDS = ['8bwt', '8vjt', '8xzn', '9e5i', '9hrf', '9sfq']

    PDB_IDS.each { pdbId ->

        test("FR3D ${pdbId} raw -> base-pair mmCIF") {

            when {
                params {
                    outdir = "${outputDir}"
                }
                process {
                    """
                    input[0] = [
                        'fr3d',
                        file("${projectDir}/../../data/tests/fr3d_outputs/${pdbId}/${pdbId}_basepair.txt"),
                        file("${projectDir}/../../data/tests/Inputs/${pdbId}.cif"),
                        file("${projectDir}/tests/fixtures/fr3d_provenance.json")
                    ]
                    """
                }
            }

            then {
                assert process.success

                def emitted = process.out[0][0]
                assert emitted[0] == 'fr3d'

                def out = path(emitted[1].toString())
                assert out.exists()
                assert emitted[1].toString().endsWith('fr3d_basepairs.cif')
                assert path(process.out.skipped[0].toString()).text.startsWith('reason\tunit_id_1\tfamily\tunit_id_2\tdetail')

                def cif = out.text
                // the annotator is appended to _software
                assert cif.contains('FR3D') && cif.contains('995de6cf5fb67e689ab8b6626988799ec4362f1e')
                assert cif.contains('_ndb_base_pair_list.base_pair_id')
                assert cif.contains('_ndb_base_pair_annotation.id')
                assert cif =~ /[ct][WHS][WHS]/
            }
        }

        test("RNApolis ${pdbId} raw -> base-pair mmCIF") {

            when {
                params {
                    outdir = "${outputDir}"
                }
                process {
                    """
                    input[0] = [
                        'rnapolis',
                        file("${projectDir}/../../data/tests/rnapolis_outputs/${pdbId}.json"),
                        file("${projectDir}/../../data/tests/Inputs/${pdbId}.cif"),
                        file("${projectDir}/tests/fixtures/rnapolis_provenance.json")
                    ]
                    """
                }
            }

            then {
                assert process.success

                def emitted = process.out[0][0]
                assert emitted[0] == 'rnapolis'

                def out = path(emitted[1].toString())
                assert out.exists()
                assert emitted[1].toString().endsWith('rnapolis_basepairs.cif')
                assert path(process.out.skipped[0].toString()).text.startsWith('reason\tresidue_1\tfamily\tresidue_2\tdetail')

                def cif = out.text
                // the annotator is appended to _software
                assert cif.contains('RNApolis') && cif.contains('5ba519b5af6de0086d02e61640bdff56e2ef6bc5')
                assert cif.contains('_ndb_base_pair_list.base_pair_id')
                assert cif.contains('_ndb_base_pair_annotation.id')
                assert cif =~ /[ct][WHS][WHS]/
            }
        }
    }
}
